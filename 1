import requests
import rasterio
import geopandas as gpd
import numpy as np
import pandas as pd
import os

BASE     = r"C:\Users\usuario\OneDrive\Desktop\AFP INTEGRA\ESG\Riesgos Fisicos\Proyecto Expected Loss"
TIF_OUT  = f"{BASE}\\lhasa_susceptibility_global.tif"
CSV_OUT  = f"{BASE}\\lhasa_susceptibilidad_por_distrito.csv"
SHP_DIST = f"{BASE}\\DISTRITOS.shp"

# ── PASO 1: Descargar GeoTIFF (~200MB) ───────────────────────────────────────
URL = "https://gpm.nasa.gov/sites/default/files/downloads/global-landslide-susceptibility-map-2-27-23.tif"

print("Descargando LHASA GeoTIFF...")
r = requests.get(URL, stream=True, timeout=300)
total = int(r.headers.get("content-length", 0))
descargado = 0

with open(TIF_OUT, "wb") as f:
    for chunk in r.iter_content(chunk_size=1024 * 1024):
        f.write(chunk)
        descargado += len(chunk)
        if total:
            print(f"  {descargado/1e6:.1f} MB / {total/1e6:.1f} MB", end="\r")

print(f"\nGuardado: {TIF_OUT}")

# ── PASO 2: Extraer valor LHASA por centroide de distrito ────────────────────
LHASA_MAP = {1: "Muy baja", 2: "Baja", 3: "Moderada", 4: "Alta", 5: "Muy alta"}

dist = gpd.read_file(SHP_DIST).to_crs("EPSG:4326")

# Centroides con CRS proyectado para precisión
dist_proj = dist.to_crs("EPSG:32718")
dist["lon"] = dist_proj.geometry.centroid.to_crs("EPSG:4326").x
dist["lat"] = dist_proj.geometry.centroid.to_crs("EPSG:4326").y

print("Extrayendo valores LHASA por distrito...")
valores = []
with rasterio.open(TIF_OUT) as src:
    print(f"  Raster CRS   : {src.crs}")
    print(f"  Raster shape : {src.width}×{src.height} px")
    print(f"  Valores únicos (muestra): verificando...")

    coords = list(zip(dist["lon"], dist["lat"]))
    for val in src.sample(coords):
        valores.append(int(val[0]) if val[0] != src.nodata else np.nan)

dist["LHASA_NUM"]  = valores
dist["LHASA_SUSC"] = dist["LHASA_NUM"].map(LHASA_MAP)

# ── PASO 3: Resultado y exportar ─────────────────────────────────────────────
resultado = dist[["UBIGEO", "DISTRITO", "PROVINCIA", "DEPARTAMEN",
                   "LHASA_NUM", "LHASA_SUSC"]].copy()

print(f"\nDistribución LHASA_SUSC:")
print(resultado["LHASA_SUSC"].value_counts())
print(f"Sin dato (nodata/0): {resultado['LHASA_SUSC'].isna().sum()}")
print(f"\nTop 10 distritos susceptibilidad Alta/Muy alta:")
print(resultado[resultado["LHASA_NUM"] >= 4]
      .sort_values("LHASA_NUM", ascending=False)
      [["DISTRITO", "PROVINCIA", "DEPARTAMEN", "LHASA_SUSC"]]
      .head(10).to_string(index=False))

resultado.to_csv(CSV_OUT, index=False, encoding="utf-8-sig")
print(f"\nGuardado: {CSV_OUT}")



import pandas as pd

BASE = r"C:\Users\usuario\OneDrive\Desktop\AFP INTEGRA\ESG\Riesgos Fisicos\Proyecto Expected Loss"

# Tabla base = todos los distritos (desde LHASA que tiene cobertura 99.8%)
lhasa  = pd.read_csv(f"{BASE}\\lhasa_susceptibilidad_por_distrito.csv", dtype={"UBIGEO": str})
hazard = pd.read_csv(f"{BASE}\\hazard_historico_por_distrito.csv",       dtype={"UBIGEO": str})
susc   = pd.read_csv(f"{BASE}\\susceptibilidad_por_distrito.csv",        dtype={"UBIGEO": str})

# Base: 1,891 distritos desde LHASA
master = lhasa[["UBIGEO", "DISTRITO", "PROVINCIA", "DEPARTAMEN", "LHASA_NUM", "LHASA_SUSC"]].copy()

# Agregar hazard histórico (NaN donde no hubo eventos = 0 eventos, no falta de dato)
cols_hazard = ["UBIGEO", "n_eventos_total", "Caida", "Deslizamiento",
               "Desplaz. Lateral", "Flujo", "Mov. Complejo", "Reptacion",
               "Vuelco", "hazard_score"]
master = master.merge(hazard[cols_hazard], on="UBIGEO", how="left")

# Rellenar NaN de eventos con 0 (distrito sin eventos registrados ≠ sin dato)
cols_eventos = ["n_eventos_total", "Caida", "Deslizamiento", "Desplaz. Lateral",
                "Flujo", "Mov. Complejo", "Reptacion", "Vuelco", "hazard_score"]
master[cols_eventos] = master[cols_eventos].fillna(0)

# Agregar susceptibilidad INGEMMET
master = master.merge(
    susc[["UBIGEO", "SUSC_MAX", "SUSC_MAX_NUM"]],
    on="UBIGEO", how="left"
)

# Verificar
print(f"Filas totales       : {len(master):,}  ← debe ser 1,891")
print(f"Con eventos > 0     : {(master['n_eventos_total'] > 0).sum():,}")
print(f"LHASA cubierto      : {master['LHASA_SUSC'].notna().sum():,}")
print(f"SUSC_MAX cubierto   : {master['SUSC_MAX'].notna().sum():,}")
print(f"\nColumnas: {list(master.columns)}")

master.to_csv(f"{BASE}\\master_movimientos_en_masa.csv", index=False, encoding="utf-8-sig")
print(f"\nGuardado: master_movimientos_en_masa.csv")
