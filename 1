# ── PASO 5: exportar ─────────────────────────────────────────────────────────
# GeoPackage reserva "FID" como PK; renombrar o soltar para evitar conflicto
gdf_export = gdf.drop(columns=[c for c in ["FID"] if c in gdf.columns])

gdf_export.to_file(OUTPUT_GPKG, driver="GPKG", layer="peligros_geologicos")
gdf_export.drop(columns="geometry").to_csv(OUTPUT_CSV, index=False, encoding="utf-8-sig")
print(f"\nGuardado: {OUTPUT_GPKG}")
print(f"Guardado: {OUTPUT_CSV}")
